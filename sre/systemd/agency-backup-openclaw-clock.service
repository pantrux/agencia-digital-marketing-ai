[Unit]
Description=Copia cifrada de la configuración y memoria de OpenClaw
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/opt/media-platform/backup-openclaw-clock-v1 /var/lib/media-platform /mnt/producciones
ConditionHost=vm-media-01

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/media-platform/backup-openclaw-clock-v1
ExecStart=/usr/bin/python3 -I -B /opt/media-platform/backup-openclaw-clock-v1/backup_321_openclaw_clock.py
Environment=LC_ALL=C.UTF-8
UMask=0077
TimeoutStartSec=13min
TimeoutStopSec=30s
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/run /var/lib/media-platform/backup-openclaw-clock-v1 /var/lib/media-platform/.agency-backup-321.lock /mnt/producciones
StandardOutput=journal
StandardError=journal
