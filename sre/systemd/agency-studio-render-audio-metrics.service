[Unit]
Description=Medición de sonoridad de los másteres de Studio
After=network-online.target
Wants=network-online.target
ConditionHost=vm-media-01
RequiresMountsFor=/mnt/producciones

[Service]
Type=oneshot
DynamicUser=yes
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/agency-studio-latency/studio_render_audio_metrics.py
LoadCredential=cloudflare-token:/var/lib/media-platform/backup-321-daily-config-v1/cloudflare.token
LoadCredential=gpu-token:/opt/media-platform/observability-gpu-v1/gpu-token
LoadCredential=nas-ca:/opt/media-platform/observability-nas-v1/collector-tls/server-ca.pem
LoadCredential=nas-client:/opt/media-platform/observability-nas-v1/collector-tls/client.pem
LoadCredential=nas-key:/opt/media-platform/observability-nas-v1/collector-tls/client.key
BindReadOnlyPaths=/mnt/producciones/proyectos
TimeoutStartSec=85s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=128M
TasksMax=16
