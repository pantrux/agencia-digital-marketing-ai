{
  "name": "studio-api-worker",
  "main": "./src/index.ts",
  "compatibility_date": "2026-11-14",
  "workers_dev": false,
  "preview_urls": false,
  "services": [{ "binding": "REFERENCE_SERVICE", "service": "studio-reference-worker" }],
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://studio.e-scale.cl",
    "BILLING_MODE": "sandbox",
    "STUDIO_PRODUCTION_ORDERS_ENABLED": "false",
    "MP_ENVIRONMENT": "sandbox",
    "MP_SITE_ID": "MLC",
    "MP_SANDBOX_CHECKOUT_ENABLED": "false",
    "STUDIO_SESSION_BATCH_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studio-saas-db",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "../migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "00000000000000000000000000000001" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "studio-media-bucket" }
  ],
  "analytics_engine_datasets": [
    { "binding": "STUDIO_HTTP_METRICS", "dataset": "studio_worker_http_v1" },
    { "binding": "STUDIO_BROWSER_METRICS", "dataset": "studio_browser_http_v1" }
  ],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "studio-jobs-queue" }],
    "consumers": [
      {
        "queue": "studio-jobs-queue",
        "dead_letter_queue": "studio-jobs-dlq",
        "max_batch_size": 2,
        "max_batch_timeout": 2,
        "max_concurrency": 2,
        "max_retries": 5,
        "retry_delay": 30
      }
    ]
  },
  "observability": { "enabled": true }
}
