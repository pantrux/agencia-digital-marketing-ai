{
  "name": "studio-d1-backup",
  "main": "./src/index.ts",
  "compatibility_date": "2026-11-14",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["0,2,5 6 * * *", "0,2,5 7 * * *"] },
  "r2_buckets": [
    { "binding": "REQUESTS", "bucket_name": "studio-backups-bucket" }
  ],
  "observability": { "enabled": true }
}
