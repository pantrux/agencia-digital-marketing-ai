[Unit]
Description=Broker loopback de Sofía para el titular
Requires=agency-sofia-runtime.service
Requisite=openclaw-gateway.service
After=agency-sofia-runtime.service openclaw-gateway.service
PartOf=openclaw-gateway.service

[Service]
Type=simple
UMask=0077
ExecStartPre=/usr/bin/python3 -I -S -B %h/.local/share/agency-sofia-owner-pilot-20261114-v6/sofia_startup_probe.py %h/.local/share/agency-sofia-owner-pilot-20261114-v6/profile.json %h/.local/share/agency-sofia-owner-pilot-20261114-v6/startup-ids.json
ExecStart=/usr/bin/python3 -I -S -B %h/.local/share/agency-sofia-owner-pilot-20261114-v6/sofia_broker.py --hmac-file %h/.local/share/agency-sofia-owner-pilot-20261114-v6/worker-hmac --owner-profile-file %h/.local/share/agency-sofia-owner-pilot-20261114-v6/profile.json --state-dir %h/.local/share/agency-sofia-owner-pilot-20261114-v6/broker-state
Restart=on-failure
RestartSec=5s
RestartSteps=5
RestartMaxDelaySec=60s
TimeoutStartSec=35s
TimeoutStopSec=45s
NoNewPrivileges=yes

[Install]
WantedBy=default.target openclaw-gateway.service
