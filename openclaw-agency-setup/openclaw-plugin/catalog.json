{
  "version": 1,
  "tools": [
    {
      "name": "mcp_immich_broll__buscar_broll",
      "tool": "buscar_broll",
      "server": "mcp-immich-broll",
      "description": "Busca B-roll mediante CLIP y devuelve identificadores de la biblioteca aprobada.",
      "schema": {
        "properties": {
          "consulta": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Consulta",
            "type": "string"
          },
          "cantidad": {
            "default": 8,
            "maximum": 20,
            "minimum": 1,
            "title": "Cantidad",
            "type": "integer"
          }
        },
        "required": [
          "consulta"
        ],
        "title": "buscar_brollArguments",
        "type": "object"
      },
      "agents": [
        "agency-strategist",
        "agency-director"
      ],
      "read_only": true
    },
    {
      "name": "mcp_media_inspector__inspeccionar_medio",
      "tool": "inspeccionar_medio",
      "server": "mcp-media-inspector",
      "description": "Inspecciona un vídeo del proyecto y publica una tira con escala de 0 a 1920.",
      "schema": {
        "properties": {
          "proyecto": {
            "title": "Proyecto",
            "type": "string"
          },
          "trabajo": {
            "title": "Trabajo",
            "type": "string"
          },
          "ruta": {
            "title": "Ruta",
            "type": "string"
          },
          "muestras": {
            "default": 6,
            "maximum": 12,
            "minimum": 1,
            "title": "Muestras",
            "type": "integer"
          }
        },
        "required": [
          "proyecto",
          "trabajo",
          "ruta"
        ],
        "title": "inspeccionar_medioArguments",
        "type": "object"
      },
      "agents": [
        "agency-account",
        "agency-director"
      ],
      "read_only": false
    },
    {
      "name": "mcp_media_inspector__transcribir_audio",
      "tool": "transcribir_audio",
      "server": "mcp-media-inspector",
      "description": "Transcribe el WAV o MP3 del proyecto con tiempos por palabra.",
      "schema": {
        "properties": {
          "proyecto": {
            "title": "Proyecto",
            "type": "string"
          },
          "ruta": {
            "title": "Ruta",
            "type": "string"
          },
          "idioma": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Idioma"
          }
        },
        "required": [
          "proyecto",
          "ruta"
        ],
        "title": "transcribir_audioArguments",
        "type": "object"
      },
      "agents": [
        "agency-account",
        "agency-director"
      ],
      "read_only": true
    },
    {
      "name": "mcp_remotion_gpu__generar_stills",
      "tool": "generar_stills",
      "server": "mcp-remotion-gpu",
      "description": "Genera los PNG de revisión en el trabajo y devuelve sus huellas.",
      "schema": {
        "$defs": {
          "RenderProps": {
            "additionalProperties": false,
            "properties": {
              "title": {
                "maxLength": 120,
                "minLength": 1,
                "title": "Title",
                "type": "string"
              },
              "duration_seconds": {
                "maximum": 600,
                "minimum": 0.1,
                "title": "Duration Seconds",
                "type": "number"
              },
              "subtitle": {
                "default": "",
                "maxLength": 240,
                "title": "Subtitle",
                "type": "string"
              },
              "background": {
                "default": "#102032",
                "pattern": "^#[0-9a-fA-F]{6}$",
                "title": "Background",
                "type": "string"
              },
              "accent": {
                "default": "#8fe3c5",
                "pattern": "^#[0-9a-fA-F]{6}$",
                "title": "Accent",
                "type": "string"
              },
              "video_path": {
                "anyOf": [
                  {
                    "maxLength": 500,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Video Path"
              },
              "audio_path": {
                "anyOf": [
                  {
                    "maxLength": 500,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Audio Path"
              }
            },
            "required": [
              "title",
              "duration_seconds"
            ],
            "title": "RenderProps",
            "type": "object"
          },
          "StillsRequest": {
            "additionalProperties": false,
            "properties": {
              "project_id": {
                "title": "Project Id",
                "type": "string"
              },
              "job_id": {
                "title": "Job Id",
                "type": "string"
              },
              "plan": {
                "enum": [
                  "Free",
                  "Pro",
                  "Ultra",
                  "Ilimitado"
                ],
                "title": "Plan",
                "type": "string"
              },
              "props": {
                "$ref": "#/$defs/RenderProps"
              },
              "composition": {
                "const": "AgencyVertical",
                "default": "AgencyVertical",
                "title": "Composition",
                "type": "string"
              },
              "format": {
                "default": "mp4",
                "enum": [
                  "mp4",
                  "prores4444"
                ],
                "title": "Format",
                "type": "string"
              },
              "resolution": {
                "default": "1080p",
                "enum": [
                  "1080p",
                  "4k"
                ],
                "title": "Resolution",
                "type": "string"
              },
              "frames": {
                "anyOf": [
                  {
                    "items": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "maxItems": 8,
                    "minItems": 1,
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Frames"
              }
            },
            "required": [
              "project_id",
              "job_id",
              "plan",
              "props"
            ],
            "title": "StillsRequest",
            "type": "object"
          }
        },
        "properties": {
          "solicitud": {
            "$ref": "#/$defs/StillsRequest"
          }
        },
        "required": [
          "solicitud"
        ],
        "title": "generar_stillsArguments",
        "type": "object"
      },
      "agents": [
        "agency-editor",
        "agency-critic"
      ],
      "read_only": false
    },
