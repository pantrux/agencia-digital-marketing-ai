      "tool": "preparar_revision",
      "server": "mcp-kitsu-review",
      "description": "Prepara la revisión solicitada de una tarea del proyecto.",
      "schema": {
        "properties": {
          "proyecto": {
            "title": "Proyecto",
            "type": "string"
          },
          "tarea": {
            "title": "Tarea",
            "type": "string"
          },
          "revision": {
            "minimum": 1,
            "title": "Revision",
            "type": "integer"
          }
        },
        "required": [
          "proyecto",
          "tarea",
          "revision"
        ],
        "title": "preparar_revisionArguments",
        "type": "object"
      },
      "agents": [
        "agency-editor"
      ],
      "read_only": false
    },
    {
      "name": "mcp_kitsu_review__adjuntar_revision",
      "tool": "adjuntar_revision",
      "server": "mcp-kitsu-review",
      "description": "Adjunta a la revisión un MP4 verificado del proyecto.",
      "schema": {
        "properties": {
          "proyecto": {
            "title": "Proyecto",
            "type": "string"
          },
          "tarea": {
            "title": "Tarea",
            "type": "string"
          },
          "revision": {
            "minimum": 1,
            "title": "Revision",
            "type": "integer"
          },
          "ruta": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Ruta",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          }
        },
        "required": [
          "proyecto",
          "tarea",
          "revision",
          "ruta",
          "sha256"
        ],
        "title": "adjuntar_revisionArguments",
        "type": "object"
