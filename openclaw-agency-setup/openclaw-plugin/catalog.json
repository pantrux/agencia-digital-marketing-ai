    {
      "name": "mcp_kitsu_review__crear_entregable",
      "tool": "crear_entregable",
      "server": "mcp-kitsu-review",
      "description": "Crea o recupera el entregable y la tarea del proyecto habilitado.",
      "schema": {
        "properties": {
          "proyecto": {
            "title": "Proyecto",
            "type": "string"
          },
          "nombre": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Nombre",
            "type": "string"
          }
        },
        "required": [
          "proyecto",
          "nombre"
        ],
        "title": "crear_entregableArguments",
