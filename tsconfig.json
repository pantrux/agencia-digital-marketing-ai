{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "cloudflare-saas/studio-api-worker/src/**/*.ts", "cloudflare-saas/studio-d1-backup/src/**/*.ts", "tests-ts/**/*.ts", "vitest.config.ts"]
}
