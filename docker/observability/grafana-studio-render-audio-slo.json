{
  "id": null,
  "uid": "agency-studio-render-audio-slo",
  "title": "Studio · Sonoridad de los másteres",
  "schemaVersion": 41,
  "version": 0,
  "tags": ["agencia", "studio", "sre"],
  "timezone": "America/Santiago",
  "refresh": "5m",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Másteres NVENC de producción · 30 días",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${PROMETHEUS_UID}" },
      "targets": [{ "refId": "A", "expr": "last_over_time(studio_render_audio_30d_samples{job=\"agency-studio-render-audio\",codec=\"nvenc\",cohorte=\"portal_produccion\"}[6m])", "instant": true, "range": false }],
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "options": { "colorMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Audio conforme en producción",
      "description": "Sonoridad integrada de −14 ± 1 LUFS y pico real ≤ −1 dBTP. Objetivo mensual del 99,5 %.",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${PROMETHEUS_UID}" },
      "targets": [{ "refId": "A", "expr": "last_over_time(studio_render_audio_30d_compliant{job=\"agency-studio-render-audio\",codec=\"nvenc\",cohorte=\"portal_produccion\"}[6m]) / (last_over_time(studio_render_audio_30d_samples{job=\"agency-studio-render-audio\",codec=\"nvenc\",cohorte=\"portal_produccion\"}[6m]) > 0)", "instant": true, "range": false }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "noValue": "Sin muestras", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0.995 }] } }, "overrides": [] },
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Antigüedad de la medición",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${PROMETHEUS_UID}" },
      "targets": [{ "refId": "A", "expr": "time()-last_over_time(studio_render_audio_report_unixtime_seconds{job=\"agency-studio-render-audio\"}[1h])", "instant": true, "range": false }],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 360 }, { "color": "red", "value": 600 }] } }, "overrides": [] },
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Másteres NVENC y conformidad por origen",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${PROMETHEUS_UID}" },
      "targets": [
        { "refId": "A", "expr": "last_over_time(studio_render_audio_30d_samples{job=\"agency-studio-render-audio\",codec=\"nvenc\",cohorte!=\"total\"}[6m])", "legendFormat": "Medidos · {{cohorte}}" },
        { "refId": "B", "expr": "last_over_time(studio_render_audio_30d_compliant{job=\"agency-studio-render-audio\",codec=\"nvenc\",cohorte!=\"total\"}[6m])", "legendFormat": "Conformes · {{cohorte}}" }
      ],
      "fieldConfig": { "defaults": { "decimals": 0, "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Cobertura de los recibos",
      "description": "Los directorios sin recibo quedan fuera de la tasa NVENC, incluidos los másteres anteriores a la firma.",
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${PROMETHEUS_UID}" },
      "targets": [
        { "refId": "A", "expr": "last_over_time(studio_render_audio_invalid_receipts{job=\"agency-studio-render-audio\"}[6m])", "legendFormat": "Recibos inválidos", "instant": true, "range": false },
        { "refId": "B", "expr": "last_over_time(studio_render_audio_directories_without_receipt{job=\"agency-studio-render-audio\"}[6m])", "legendFormat": "Directorios sin recibo", "instant": true, "range": false }
      ],
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "options": { "colorMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    }
  ]
}
