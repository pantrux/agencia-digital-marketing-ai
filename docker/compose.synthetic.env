# Sólo sintaxis de CI: estos IDs y nombres NO identifican recursos reales.
# No contiene contraseñas ni se utiliza para iniciar servicios.
MEDIA_COMPOSE_PROJECT_NAME=agency-ci-synthetic
MEDIA_POSTGRES_APPS_IMAGE_ID=sha256:1111111111111111111111111111111111111111111111111111111111111111
MEDIA_VALKEY_OCI_CAPTURE_V2_MANIFEST_DIGEST=sha256:2222222222222222222222222222222222222222222222222222222222222222
MEDIA_ZOU_APPLICATION_IMAGE_MANIFEST=sha256:3333333333333333333333333333333333333333333333333333333333333333
MEDIA_PLATFORM_DATA_NETWORK_NAME=agency-ci-synthetic-data
MEDIA_PLATFORM_APP_NETWORK_NAME=agency-ci-synthetic-app
MEDIA_POSTGRES_APPS_ADMIN_USER=synthetic_pg_admin
MEDIA_POSTGRES_APPS_ADMIN_DATABASE=synthetic_pg_admin_db
MEDIA_POSTGRES_APPS_DATA_PATH=/var/lib/media-platform/ci-synthetic/postgres-apps
MEDIA_POSTGRES_APPS_PASSWORD_FILE=/opt/media-platform/ci-synthetic/secrets/postgres-password
MEDIA_POSTGRES_APPS_PGPASS_FILE=/opt/media-platform/ci-synthetic/secrets/postgres-pgpass
MEDIA_VALKEY_DATA_PATH=/var/lib/media-platform/ci-synthetic/valkey
MEDIA_VALKEY_CONFIG_FILE=/opt/media-platform/ci-synthetic/valkey/valkey.conf
MEDIA_VALKEY_PASSWORD_FILE=/opt/media-platform/ci-synthetic/secrets/valkey-password
MEDIA_ZOU_DATABASE_USER=synthetic_zou
MEDIA_ZOU_DATABASE_NAME=synthetic_zoudb
MEDIA_ZOU_DOMAIN_NAME=synthetic.invalid
MEDIA_ZOU_DOMAIN_PROTOCOL=http
MEDIA_ZOU_STATE_PATH=/var/lib/media-platform/ci-synthetic/zou
MEDIA_ZOU_PREVIEWS_PATH=/mnt/producciones/ci-synthetic/previews
MEDIA_ZOU_DB_PASSWORD_FILE=/opt/media-platform/ci-synthetic/secrets/zou-db-password
MEDIA_ZOU_KV_PASSWORD_FILE=/opt/media-platform/ci-synthetic/secrets/zou-kv-password
MEDIA_ZOU_SECRET_KEY_FILE=/opt/media-platform/ci-synthetic/secrets/zou-secret-key
